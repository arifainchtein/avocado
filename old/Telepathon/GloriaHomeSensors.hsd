            "Units":"l/min",
            "Value Type":"double",
            "Range Maximum":120,
            "Range Minimum":0,
            "Initial Value":0,
            "Reporting Value Dene Name":"Flow 1",
            "Human Interface Panel":"Sensors" ,
             "Panel Display Name":"Flow 1"
        },
        {
            "Name":"FlowMeter2",
            "Units":"l/min",
            "Value Type":"double",
            "Range Maximum":120,
            "Range Minimum":0,
            "Initial Value":0,
            "Reporting Value Dene Name":"Flow 2",
            "Human Interface Panel":"Sensors" ,
            "Panel Display Name":"Flow 2"
