{
    "Homeobox Definition Type":"Sensor",
    "Homeobox Name":"Gloria Home Internal Energy Values",
    "Sensor Name":"Gloria Home Internal Energy Values Sensor",
    "Microcontroller Pointer":"@Egg:Internal:Components:Mother Microcontroller",
    "Provider":"https://www.digitalstables.com",
    "Port":"Internal",

    "Values":[
        {
            "Name":"BatteryVoltage",
            "Units":"Volts",
            "Value Type":"double",
            "Sensor Request Queue Position":1,
            "Range Maximum":15,
            "Range Minimum":11,
            "Initial Value":0,
            "Reporting Value Dene Name":"Battery Voltage",
            "Human Interface Panel":"Internal Power Data" ,
            "Panel In Panel Position":1,
            "Panel Display Name":"Bat Vol"
        },
        {
            "Name":"Lock Voltage",
            "Units":"Volts",
            "Value Type":"double",
            "Sensor Request Queue Position":2,
            "Range Maximum":5.5,
            "Range Minimum":0.0,
            "Initial Value":0,
            "Reporting Value Dene Name":"Lock Voltage",
            "Human Interface Panel":"Internal Power Data" ,
            "Panel In Panel Position":3,
            "Panel Display Name":"Lock Voltage"
        },
        {
            "Name":"InternalBatteryStateOfCharge",
            "Units":"%",
            "Value Type":"double",
            "Sensor Request Queue Position":3,
            "Range Maximum":100,
            "Range Minimum":0,
            "Initial Value":0,
            "Reporting Value Dene Name":"Power Status",
            "Human Interface Panel":"Internal Power Data" ,
            "Panel In Panel Position":3,
            "Panel Display Name":"Battery SOC"
        },
        {
            "Name":"OperatingStatus",
            "Units":"",
            "Value Type":"String",
            "Sensor Request Queue Position":4,
            "Initial Value":"WPS",
            "Reporting Value Dene Name":"Power Status",
            "Human Interface Panel":"Internal Power Data" ,
            "Panel In Panel Position":5,
            "Panel Display Name":"Oper Status"
        },
        {
            "Name":"DailyMinBatteryVoltage",
            "Units":"Volts",
            "Value Type":"double",
            "Sensor Request Queue Position":5,
            "Range Maximum":15,
            "Range Minimum":11,
            "Initial Value":0,
            "Reporting Value Dene Name":"Daily Power Stats",
            "Human Interface Panel":"Internal Power Daily Stats" ,
            "Panel In Panel Position":1,
            "Panel Display Name":"Minimum Bat"
        },
        {
            "Name":"DailyMaxBatteryVoltage",
            "Units":"Volts",
            "Value Type":"double",
            "Sensor Request Queue Position":6,
            "Range Maximum":15,
            "Range Minimum":11,
            "Initial Value":0,
            "Reporting Value Dene Name":"Daily Power Stats",
            "Human Interface Panel":"Internal Power Daily Stats" ,
            "Panel In Panel Position":2,
            "Panel Display Name":"Maximum Batt"
        },
        {
            "Name":"DailyBatteryOutEnergy",
            "Units":"mAHr",
            "Value Type":"double",
            "Sensor Request Queue Position":7,
            "Range Maximum":20000,
            "Range Minimum":0,
            "Initial Value":0,
            "Reporting Value Dene Name":"Daily Power Stats",
            "Human Interface Panel":"Internal Power Daily Stats" ,
            "Panel In Panel Position":5,
            "Panel Display Name":"Bat Energy Out"
        },
        {
            "Name":"DailyPoweredDownInLoopSeconds",
            "Units":"sec",
            "Value Type":"int",
            "Sensor Request Queue Position":8,
            "Range Maximum":20000,
            "Range Minimum":0,
            "Initial Value":0,
            "Reporting Value Dene Name":"Daily Power Stats",
            "Human Interface Container":"@Egg:Human Interface:Home Page" ,
            "Human Interface Panel":"Internal Power Daily Stats" ,
            "Panel In Panel Position":6,
            "Panel Display Name":"Bat Energy Out"
