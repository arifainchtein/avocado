{
    "Homeobox Definition Type":"FlowNetworkSensor",
    "Homeobox Name":"Gloria Field Flow Sensor Network Values",
    "Sensor Name":"Gloria Field Flow Sensor Network Values",
    "Microcontroller Pointer":"@Egg:Internal:Components:Mother Microcontroller",
    "Provider":"https://www.digitalstables.com",
    "Port":"Internal",
    "sampleFrequencySeconds":10,
	"withDistributionPoint":false,
	"withCentralWaste":false,
